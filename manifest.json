{
  "manifest_version": 2,
  "name": "GRE Word Helper",
  "version": "1.0",
  "description": "Highlights GRE words on webpages and shows their meanings",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "browser_action": {
    "default_icon": {
      "19": "icons/icon-19.png",
      "38": "icons/icon-38.png"
    },
    "default_title": "GRE Word Helper",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["js/wordlist.js", "js/content.js"]
    }
  ],
  "web_accessible_resources": [
    "css/tooltip.css"
  ]
} 