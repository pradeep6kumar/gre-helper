{
  "manifest_version": 2,
  "name": "GRE Word Helper",
  "version": "1.0",
  "description": "Helps users learn GRE vocabulary by highlighting words on web pages and showing their meanings in tooltips",
  "icons": {
    "19": "icons/icon-19.png",
    "38": "icons/icon-38.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "<all_urls>"
  ],
  "browser_action": {
    "default_icon": {
      "19": "icons/icon-19.png",
      "38": "icons/icon-38.png"
    },
    "default_popup": "popup/popup.html",
    "default_title": "GRE Word Helper"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["js/wordlist.js", "js/content.js"],
      "css": ["css/tooltip.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    "js/wordlist.js"
  ]
} 